# Only the game itself is published. Everything else in this folder (source models, the rendered
# video, earlier versions, generation scripts) stays on this computer.
/*
!/.gitignore
!/.vercelignore
!/README.md
!/index.html
!/main.js
!/start.bat
!/lib180/
!/tools/
!/assets/

/tools/*
!/tools/serve.ps1
!/tools/serve.py
!/tools/record_server.py
!/tools/director.js
!/tools/board.js
!/tools/shrink_glb.py

/assets/*
!/assets/pano_start.jpg
!/assets/pano_end.jpg
!/assets/world_full_res.spz
!/assets/world_500k.spz
!/assets/world_collider.glb
!/assets/models/

/assets/models/*
!/assets/models/phoenix.glb
!/assets/models/fan.glb
!/assets/models/guardian2.glb
!/assets/models/door2.glb
!/assets/models/temple.glb
!/assets/models/yleaf.glb
!/assets/models/yflower.glb
!/assets/models/hand2.glb

.vercel
